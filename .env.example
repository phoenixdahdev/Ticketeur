# ─── Database (Postgres) ────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/ticketur"

# ─── Better Auth ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated list of trusted origins (apps that share auth)
APP_URLS="http://localhost:3000"

# ─── Google OAuth (optional) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Trigger.dev (background jobs) ──────────────────────────────────────
TRIGGER_PROJECT_ID=""
TRIGGER_SECRET_KEY=""

# ─── Resend (transactional email) ───────────────────────────────────────
RESEND_API_KEY=""

# ─── Vercel Blob (uploads — event banner, vendor logo/banner/showcase) ──
BLOB_READ_WRITE_TOKEN=""

# ─── Flutterwave (Standard checkout for ticket purchases) ───────────────
# Test keys start with FLWPUBK_TEST- / FLWSECK_TEST-. The webhook secret is
# whatever string you set under "Secret hash" in the Flutterwave dashboard;
# we compare it against the `verif-hash` header on inbound webhooks.
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
FLW_SECRET_HASH=""

# ─── Axiom (observability — OpenTelemetry traces + structured logs) ─────
# Create an ingest API token and a dataset in the Axiom dashboard, then set
# them here (local) and in Vercel (both apps). AXIOM_HOST defaults to
# api.axiom.co — use api.eu.axiom.co if your Axiom org is in the EU region.
# Leave AXIOM_TOKEN empty to disable Axiom (tracing + logging become no-ops).
AXIOM_TOKEN=""
AXIOM_DATASET="ticketeur"
AXIOM_HOST="api.axiom.co"

# ─── Public (Next.js) ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# GA4 measurement ID. Left empty here so local and preview runs send nothing
# to the production property — set it in the production environment only.
NEXT_PUBLIC_GA_ID=""
