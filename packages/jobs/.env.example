# Read by trigger.config.ts and src/tasks/*.
# DATABASE_URL is transitively required via the @ticketur/db import chain.

DATABASE_URL="postgresql://user:password@localhost:5432/ticketur"

# ─── Trigger.dev ────────────────────────────────────────────────────────
# Project ID from https://cloud.trigger.dev (required to run `trigger dev`)
TRIGGER_PROJECT_ID=""
# Only needed for `trigger deploy`
TRIGGER_SECRET_KEY=""

# ─── Resend (used inside each task via src/utils/resend.ts) ─────────────
RESEND_API_KEY=""

# ─── Order reconciliation (src/tasks/reconcile-pending-orders.ts) ───────
# The web app's canonical public URL, which the scheduled task calls (a URL
# that redirects is refused), and the bearer secret the web app expects: the
# same CRON_SECRET value the web app has.
NEXT_PUBLIC_APP_URL=""
CRON_SECRET=""
